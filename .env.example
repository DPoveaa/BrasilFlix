# ==========================================
# BRASILFLIX CONFIGURATION & DATABASE (.env.example)
# ==========================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brasilflix
DB_USER=postgres
DB_PASSWORD=admin

# Telegram Bot
BOT_TOKEN=
STORAGE_GROUP_ID=
ADMIN_ID=
NOTIFICATION_GROUP_ID=

# Mercado Pago
MERCADOPAGO_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# TMDB (The Movie Database)
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR

# Telegram MTProto Premium Session
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Web Dashboard & Stremio Addon Server
STREMIO_PORT=7000
SERVER_HOST=localhost:7000

# Automation Settings
AUTO_FEEDER_ENABLED=true
AUTO_FEEDER_INTERVAL_HOURS=4
ALLOW_CINEMA_CAM=true
AUTO_UPGRADE_CAM=true
TARGET_RESOLUTION=1080p
